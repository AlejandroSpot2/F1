# Ignore local Python virtual environments
**/.venv/

# Ignore Python cache
**/__pycache__/
**/*.pyc
**/.fastf1_cache/

# Ignore Node dependencies and local browser artifacts
node_modules/
.tmp-playwright/
.playwright-mcp/
.playwright-cli/
.superpowers/
.miktex/
.tex-appdata/
.tools/
output/
f1-static-server*.log
final_deliverable/

# Ignore LaTeX build intermediates
**/*.aux
**/*.bbl
**/*.blg
**/*.log
**/*.out
**/*.toc

# Ignore local instructions dropped into subfolders
**/Instructions.md
